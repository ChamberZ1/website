---
interface Props { title: string; description: string; href: string }
const { title, description, href } = Astro.props;
---
<article class="project-card">
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={href} target="_blank" rel="noopener noreferrer"><span class="visually-hidden">{title} on </span>GitHub<svg class="external-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</article>
