---
import { profile } from '../data/profile';
import { liveSections } from '../data/sections';

interface Props { home?: boolean }
const { home = false } = Astro.props;
---
<header class="sidebar">
    <div class="sidebar-heading">
        <button type="button" id="sidebar-toggle" class="sidebar-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar-content" hidden>
            <span class="hamburger-icon" aria-hidden="true"></span>
        </button>
        {home ? <h1 class="site-name">{profile.name}</h1> : <a class="site-name" href="/">{profile.name}</a>}
    </div>

    <div id="sidebar-content" class="sidebar-content">
        <nav class="links" aria-label="Site">
            <a href="/" aria-current={home ? 'page' : undefined}>Projects</a>
            {liveSections.map((section) => <a href={section.href}>{section.label}</a>)}
        </nav>

        <nav class="links links-profile" aria-label="Profile and contact">
            {profile.links.map(({ label, href }) => href.startsWith('mailto:')
                ? <a href={href}>{label}</a>
                : <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
        </nav>

        <div class="actions">
            <a class="resume-link" href={profile.resume} target="_blank" rel="noopener noreferrer">Resume</a>
        </div>
    </div>
</header>
