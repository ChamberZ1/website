---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionCard from '../components/SectionCard.astro';
import { projects } from '../data/projects';
import { liveSections } from '../data/sections';
---
<Base title="Charles Zhao" description="Charles Zhao personal portfolio website" path="/" home>
    <section class="section" id="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        <div class="project-grid">
            {projects.map((project) => <ProjectCard {...project} />)}
        </div>
    </section>

    <section class="section" aria-labelledby="explore-heading">
        <h2 id="explore-heading">Explore</h2>
        <div class="project-grid">
            {liveSections.map((section) => <SectionCard {...section} />)}
        </div>
    </section>
</Base>
