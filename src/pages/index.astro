---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionCard from '../components/SectionCard.astro';
import PostList from '../components/PostList.astro';
import { projects } from '../data/projects';
import { getPosts } from '../data/posts';
import { profile } from '../data/profile';
import { getLiveSections } from '../data/sections';

const channel = profile.links.find(({ label }) => label === 'YouTube');
const cards = [
    ...await getLiveSections(),
    ...(channel ? [{ ...channel, summary: 'My YouTube channel.', icon: 'M3 6.5h18v11H3zM10.5 9.5v5l4-2.5z' }] : []),
];
const posts = (await getPosts()).filter(({ data }) => data.showOnHome);
---
<Base title="Charles Zhao" description="Charles Zhao personal portfolio website" path="/">
    <section class="section" id="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        <div class="project-grid">
            {projects.map((project) => <ProjectCard {...project} />)}
        </div>
    </section>

    {posts.length > 0 && (
        <section class="section" aria-labelledby="writing-heading">
            <h2 id="writing-heading">Writing</h2>
            <PostList posts={posts} heading="h3" />
        </section>
    )}

    <section class="section" aria-labelledby="explore-heading">
        <h2 id="explore-heading">Explore</h2>
        <div class="project-grid">
            {cards.map((card) => <SectionCard {...card} />)}
        </div>
    </section>
</Base>
