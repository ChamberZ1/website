---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPosts } from '../data/posts';

interface Props {
    title: string;
    description: string;
    /** Public path without .html, for example "/" or "/bookmarks". */
    path?: string;
    noindex?: boolean;
    /** Preview image path for shared links. */
    image?: string;
    /** Publication date (YYYY-MM-DD) of an article. */
    published?: string;
    /** schema.org data for search engines. */
    schema?: object;
}

const { title, description, path, noindex = false, image, published, schema } = Astro.props;
const url = path && new URL(path, Astro.site).href;
const hasFeed = (await getPosts()).length > 0;
// The dev server needs inline code and a websocket; the built site does not.
// Cloudflare adds its Web Analytics script, which reports to cloudflareinsights.com.
const csp = import.meta.env.PROD && "default-src 'none'; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; img-src 'self'; connect-src https://cloudflareinsights.com; manifest-src 'self'; base-uri 'self'; form-action 'none';";
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}
        <title>{title}</title>

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={published ? 'article' : 'website'} />
        <meta property="og:site_name" content="Charles Zhao" />
        <meta property="og:image" content={new URL(image ?? '/assets/img/link-preview.png', Astro.site).href} />
        {!image && <meta property="og:image:width" content="1200" />}
        {!image && <meta property="og:image:height" content="630" />}
        <meta property="og:image:alt" content={image ? title : 'Charles Zhao, zcharles.com'} />
        <meta name="twitter:card" content="summary_large_image" />
        {published && <meta property="article:published_time" content={published} />}
        {url && <meta property="og:url" content={url} />}
        {url && <link rel="canonical" href={url} />}

        {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="manifest" href="/site.webmanifest" />
        {hasFeed && <link rel="alternate" type="application/rss+xml" title="Charles Zhao" href="/rss.xml" />}
        {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
        <script is:inline src="/js/theme.js"></script>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark and light mode">
            <span class="theme-toggle-icon" aria-hidden="true"></span>
        </button>

        <div class="page-layout">
            <Header path={path} />
            <div class="content">
                <main id="main" tabindex="-1">
                    <slot />
                </main>
                <Footer />
            </div>
        </div>

        <script is:inline src="/js/index.js"></script>
    </body>
</html>
